<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile for the Jetson robot stack during Jetson-in-the-loop sim.

  The container runs with host networking on the Jetson. Force UDPv4 onto the
  direct Jetson Ethernet address and announce to the sim VM's Lima shared
  address. On this Mac, the VM's direct bridged 10.66.0.4 path passes ICMP but
  not reliable DDS data, so the robust data path is Jetson 10.66.0.2 -> Mac
  router -> VM 192.168.105.2. Keep loopback enabled too so the Jetson's many
  local ROS participants discover each other without depending on Ethernet
  hairpin behavior.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>autonav_jetson_robot_udp</transport_id>
      <type>UDPv4</type>
      <maxInitialPeersRange>64</maxInitialPeersRange>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>10.66.0.2</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="autonav_jetson_robot_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>autonav_jetson_robot_udp</transport_id>
      </userTransports>
      <builtin>
        <discovery_config>
          <leaseDuration>
            <sec>20</sec>
          </leaseDuration>
          <leaseAnnouncement>
            <sec>1</sec>
          </leaseAnnouncement>
          <initialAnnouncements>
            <count>10</count>
            <period>
              <sec>0</sec>
              <nanosec>100000000</nanosec>
            </period>
          </initialAnnouncements>
        </discovery_config>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>10.66.0.2</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.105.2</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
